Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Global Options:
    Fixed Frame: base
    Frame Rate: 30
    Background Color: 48; 48; 48
  Tools:
    - Class: rviz_default_plugins/MoveCamera
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 1.35
      Focal Point:
        X: 0.10
        Y: 0.0
        Z: 0.25
      Pitch: 0.35
      Yaw: 3.6
    Saved: ~
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Alpha: 0.5
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Arrows: false
      Show Axes: false
      Show Names: false
    - Class: rviz_default_plugins/RobotModel
      Name: SO-101
      Description Source: Topic
      Description Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /robot_description
      Visual Enabled: true
      Collision Enabled: false
      Alpha: 1.0
      Enabled: true
    - Class: rviz_default_plugins/RobotModel
      # Second arm (two-arm plan, Phase 4): its own /arm2/robot_description latched
      # by the arm2 bridge, its TF tree prefixed arm2_ so it does not collide with
      # the first arm, positioned by the static base -> arm2_base at 0,0.30,0.
      Name: SO-101 (arm 2)
      Description Source: Topic
      Description Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /arm2/robot_description
      TF Prefix: arm2_
      Visual Enabled: true
      Collision Enabled: false
      Alpha: 1.0
      Enabled: true
    - Class: rviz_default_plugins/Image
      Name: Cameras (scene | arm 1 | arm 2)
      Enabled: true
      Topic:
        Value: /gripper/cameras/compressed
        Depth: 5
        History Policy: Keep Last
        Reliability Policy: Reliable
        Durability Policy: Volatile
      Transport Hint: compressed
      Max Value: 1
      Min Value: 0
      Median window: 5
      Normalize Range: true
    - Class: rviz_default_plugins/PointCloud2
      Name: Scene cloud
      Topic:
        Value: /oak/scene/points
      Size (Pixels): 2
      Style: Points
      Enabled: false
Window Geometry:
  Displays:
    collapsed: false
  Width: 1280
  Height: 800

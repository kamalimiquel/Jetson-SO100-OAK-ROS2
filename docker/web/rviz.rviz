Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Global Options:
    Fixed Frame: base
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
    - Class: rviz_default_plugins/TF
      Name: TF
    - Class: rviz_common/RobotModel
      Name: SO-100
      Description Topic:
        Value: /robot_description
      Enabled: true
    - Class: rviz_default_plugins/Image
      Name: Scene color
      Topic:
        Value: /oak/scene/color/compressed
      Transport Hint: compressed
      Enabled: true
    - Class: rviz_default_plugins/PointCloud2
      Name: Scene cloud
      Topic:
        Value: /oak/scene/points
      Size (Pixels): 2
      Style: Points
      Enabled: true
Window Geometry:
  Displays:
    collapsed: false
  Width: 1280
  Height: 800

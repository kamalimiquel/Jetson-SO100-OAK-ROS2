Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Global Options:
    Fixed Frame: base
    Frame Rate: 30
    Background Color: 48; 48; 48
  Tools:
    - Class: rviz_default_plugins/MoveCamera
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 1.0
      Focal Point:
        X: 0.0
        Y: -0.15
        Z: -0.02
      Pitch: 0.35
      Yaw: 3.1416
    Saved: ~
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Alpha: 0.5
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Arrows: false
      Show Axes: false
      Show Names: false
    - Class: rviz_default_plugins/RobotModel
      Name: SO-100
      Description Source: Topic
      Description Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /robot_description
      Visual Enabled: true
      Collision Enabled: false
      Alpha: 1.0
      Enabled: true
    - Class: rviz_default_plugins/Image
      Name: Scene color
      Topic:
        Value: /oak/scene/color/compressed
      Transport Hint: compressed
      Enabled: true
    - Class: rviz_default_plugins/Image
      Name: Scene depth
      Topic:
        Value: /oak/scene/depth/color/compressed
      Transport Hint: compressed
      Enabled: true
    - Class: rviz_default_plugins/Image
      Name: Scene confidence
      Topic:
        Value: /oak/scene/confidence/compressed
      Transport Hint: compressed
      Enabled: true
    - Class: rviz_default_plugins/PointCloud2
      Name: Scene cloud
      Topic:
        Value: /oak/scene/points
      Size (Pixels): 2
      Style: Points
      Enabled: false
Window Geometry:
  Displays:
    collapsed: false
  Width: 1280
  Height: 800

Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Global Options:
    Fixed Frame: base
    Frame Rate: 30
  Views:
    Current View:
      Class: rviz_default_plugins/Orbit
      Distance: 1.2
      Focal Point:
        X: 0
        Y: 0
        Z: 0.15
      Pitch: 0.35
      Yaw: 0.9
    Saved: ~
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
    - Class: rviz_default_plugins/RobotModel
      Name: SO-100
      Description Topic:
        Value: /robot_description
      Enabled: true
    - Class: rviz_default_plugins/Image
      Name: Scene color
      Topic:
        Value: /oak/scene/color/compressed
      Transport Hint: compressed
      Enabled: true
    - Class: rviz_default_plugins/PointCloud2
      Name: Scene cloud
      Topic:
        Value: /oak/scene/points
      Size (Pixels): 2
      Style: Points
      Enabled: false
Window Geometry:
  Displays:
    collapsed: false
  Width: 1280
  Height: 800

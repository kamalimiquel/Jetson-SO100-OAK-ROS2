Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Global Options:
    Fixed Frame: base
    Frame Rate: 30
    Background Color: 48; 48; 48
  Tools:
    - Class: rviz_default_plugins/MoveCamera
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 1.40
      Focal Point:
        X: 0.0
        Y: 0.15
        Z: 0.25
      Pitch: 0.35
      Yaw: 3.14
    Saved: ~
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Alpha: 0.5
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Arrows: false
      Show Axes: false
      Show Names: false
    - Class: rviz_default_plugins/RobotModel
      # ONE model for both arms: RViz on this board draws only the first display of a class, so a
      # second RobotModel reports OK and renders nothing. /cell/robot_description is the merged URDF
      # (arm 1 plain + arm 2 as arm2_*, fixed base->arm2_base at 0,0.30,0) published latched by the
      # arm container; the same RSP drives it from /cell/joint_states_rad.
      Name: SO-101 x2 (cell)
      Enabled: true
      Description Source: Topic
      Description Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /cell/robot_description
      Visual Enabled: true
      Collision Enabled: false
      Alpha: 1.0
    - Class: rviz_default_plugins/Image
      Name: Cameras (scene | arm 1 | arm 2)
      Enabled: true
      Topic:
        Value: /gripper/cameras/compressed
        Depth: 5
        History Policy: Keep Last
        Reliability Policy: Reliable
        Durability Policy: Volatile
      Transport Hint: compressed
      Max Value: 1
      Min Value: 0
      Median window: 5
      Normalize Range: true
    - Class: rviz_default_plugins/PointCloud2
      Name: Scene cloud
      Topic:
        Value: /oak/scene/points
      Size (Pixels): 2
      Style: Points
      Enabled: false
Window Geometry:
  Displays:
    collapsed: false
  Width: 1280
  Height: 800

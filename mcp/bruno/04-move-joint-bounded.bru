  "params": {
    "name": "move_joint_bounded",
    "arguments": {
      "arm": "{{arm}}",
      "angles": [
        0,
        0,
        0,
        0,
        0,
        50
      ],
      "mission_id": "{{mission}}",
      "deadline_s": 1.0
    }
  }
}
}

headers {
  Content-Type: application/json
}

docs {
  Degrees by name, jaw in percent here only as a legacy boundary. Refused if the cell is not parked.
}

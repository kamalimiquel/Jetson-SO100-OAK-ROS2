  "id": 9,
  "method": "tools/call",
  "params": {
    "name": "get_goal",
    "arguments": {
      "mission_id": "{{mission}}"
    }
  }
}
}

headers {
  Content-Type: application/json
}

docs {
  What the journal says about a mission.
}
